{
  "name": "@local/dsh-notify",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop notifications when a DeepSeek Harness turn finishes or a tool asks for approval. · 任务完成或需要审批时弹出系统通知。",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
